#!/bin/bash
# 시선.app — 더블클릭하면 관제 창이 열립니다.
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
HERE=""
for _ in 1 2 3 4 5 6 7 8; do
  DIR="$(cd "$DIR/.." && pwd)"
  if [ -f "$DIR/team7_desktop.py" ]; then
    HERE="$DIR"
    break
  fi
done
if [ -z "$HERE" ]; then
  osascript -e 'display alert "시선" message "team7_desktop.py 를 찾지 못했습니다. 압축을 폴더 채로 풀어 주세요."'
  exit 1
fi
cd "$HERE"
export SISUN_DESKTOP=1
PY=""
if command -v python3 >/dev/null 2>&1; then PY=python3
elif command -v python >/dev/null 2>&1; then PY=python
fi
if [ -z "$PY" ]; then
  osascript -e 'display alert "시선" message "Python 3 가 필요합니다. python.org 에서 설치한 뒤 다시 실행하세요."'
  exit 1
fi
exec "$PY" "$HERE/team7_desktop.py"
